# ---------------------------------------------------------------------------
# Notette configuration
# Copy this file to .env and adjust. Used by docker-compose.yml and by the app.
# ---------------------------------------------------------------------------

# Public URL of this Notette instance (no trailing slash). Used for the embed
# snippet, the admin sign-in popup, secure cookies and CSRF origin checks.
NOTETTE_URL=http://localhost:3000

# Host port to expose the app on (docker compose only).
NOTETTE_PORT=3000

# PostgreSQL (docker compose creates the database with these values).
POSTGRES_DB=notette
POSTGRES_USER=notette
POSTGRES_PASSWORD=change-me

# For local development outside Docker, point the app at your own database.
DATABASE_URL=postgres://notette:change-me@localhost:5432/notette

# Optional: create the first admin account automatically on startup. The account
# is only created if no user with this email exists yet. Alternatively, open
# NOTETTE_URL/setup in a browser after the first start.
NOTETTE_ADMIN_EMAIL=
NOTETTE_ADMIN_PASSWORD=
NOTETTE_ADMIN_NAME=Admin

# Where screenshots are stored (a persistent volume in Docker).
NOTETTE_UPLOADS_DIR=./data/uploads

# Maximum accepted screenshot size in bytes (default 8 MiB).
NOTETTE_MAX_SCREENSHOT_BYTES=8388608

# Dashboard/widget session lifetime in days.
NOTETTE_SESSION_DAYS=30

# Run database migrations automatically at startup (true/false).
NOTETTE_AUTO_MIGRATE=true

# When running behind a reverse proxy, tell the server which header carries the
# real client IP (used for rate limiting). Leave empty if not behind a proxy.
ADDRESS_HEADER=
XFF_DEPTH=1

# Optional outgoing email (SMTP). When SMTP_HOST and EMAIL_FROM are set, Notette
# emails admins and thread participants about new feedback, replies and
# @-mentions (grouped per recipient, sent about a minute after the first
# update; everyone can turn it off per project), and projects can require
# widget sign-ups to confirm their email address. Leave empty to disable.
SMTP_HOST=
SMTP_PORT=587
# Implicit TLS (SMTPS). Defaults to true for port 465; STARTTLS is used otherwise when offered.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Sender address, e.g. "Notette <feedback@example.com>".
EMAIL_FROM=
# Seconds to collect activity for one recipient before sending a single digest email.
NOTETTE_EMAIL_BATCH_SECONDS=60
